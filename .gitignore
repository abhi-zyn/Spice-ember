# ============================================
# SPICE & EMBER - .gitignore
# ============================================

# Environment variables (contains secrets — NEVER commit)
.env
.env.local
.env.*.local

# Supabase local development
supabase/.temp/
supabase/.branches/

# Node modules (if using Supabase CLI locally)
node_modules/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*

# Build output
dist/
build/

# Cloudflare
.wrangler/

.dev.vars*
!.dev.vars.example
!.env.example
