# ============================================
# SPICE & EMBER - Environment Variables
# ============================================
# Copy this file to .env.local and fill in your real values.
# .env.local is gitignored — NEVER commit it.
#
# This .env.example file IS safe to push to GitHub.
# ============================================

# --- Razorpay ---
# Your Razorpay Key ID (starts with rzp_live_ or rzp_test_)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
# Your Razorpay Key Secret (get from Razorpay Dashboard → Settings → API Keys)
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
# Your Razorpay Webhook Secret (get from Razorpay Dashboard → Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# --- Supabase ---
# Your Supabase project URL (e.g., https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Supabase Service Role Key (get from Supabase Dashboard → Settings → API)
# WARNING: This key bypasses RLS — NEVER expose it in frontend code
SUPABASE_SECRET_KEY=your_secret_key_here
# Supabase Anon Key (safe for frontend — already in js/config.js)
# SUPABASE_ANON_KEY=your_anon_key_here